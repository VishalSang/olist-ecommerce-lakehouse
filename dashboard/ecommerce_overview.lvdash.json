                    {
                      "name": "sum(merchandise_sales_brl)",
                      "expression": "SUM(`merchandise_sales_brl`)"
                    },
                    {
                      "name": "product_category",
                      "expression": "`product_category`"
                    }
                  ],
                  "disaggregated": false,
                  "orders": [
                    {
                      "direction": "DESC",
                      "expression": "SUM(`merchandise_sales_brl`)"
