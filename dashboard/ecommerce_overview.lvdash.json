                    "abbreviation": "none",
                    "currencyCode": "BRL",
                    "type": "number-currency"
                  },
                  "scale": {
                    "type": "quantitative"
                  }
                },
                "y": {
                  "fieldName": "product_category",
                  "scale": {
                    "categorySize": {
                      "number": 10,
                      "type": "number-of-categories"
                    },
                    "type": "categorical",
                    "sort": {
                      "by": "measure-reversed",
                      "measure": {
                        "fieldName": "sum(merchandise_sales_brl)"
                      }
                    }
                  }
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 6,
            "y": 3,
            "width": 6,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "methodology_note",
            "multilineTextboxSpec": {
              "lines": [
                "## Methodology\n",
                "\n",
                "- Metrics cover delivered orders in the Olist dataset.\n",
                "- Monthly sales are grouped by purchase month.\n",
                "- Merchandise sales exclude freight and are not profit or net revenue.\n",
                "- Repeat customers have at least two delivered orders in this dataset.\n",
                "- Lateness compares calendar delivery dates with estimated dates.\n",
                "- Eight delivered orders lack dates needed for lateness checks.\n",
                "- Carrier transit averages exclude inconsistent shipping sequences.\n",
                "- Source coverage includes incomplete months.\n",
                "- Category names retain their original Portuguese labels."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 9,
            "width": 12,
            "height": 6
