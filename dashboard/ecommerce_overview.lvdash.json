      }
    },
    {
      "name": "c5efffb5",
      "displayName": "gold_customer_metrics",
      "config": {
        "version": "1.1",
        "source": "workspace.ecommerce.gold_customer_metrics",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
