          },
          {
            "name": "repeat_customer_count",
            "expr": "COUNT_IF(`repeat_customer_flag`)",
            "displayName": "Repeat Customers"
          }
        ]
      }
    },
    {
      "name": "d4519be5",
      "displayName": "gold_delivery_metrics",
      "config": {
        "version": "1.1",
        "source": "workspace.ecommerce.gold_delivery_metrics",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          },
          {
            "name": "late_delivery_rate",
            "expr": "100.0 * SUM(`late_order_count`) / NULLIF(SUM(`orders_with_lateness_check`), 0)",
            "displayName": "Late Delivery Rate"
          }
        ]
      }
    },
    {
      "name": "top_10_cat",
      "displayName": "Top 10 Categories",
      "config": {
        "version": "1.1",
        "source": "SELECT * FROM workspace.ecommerce.gold_category_sales ORDER BY `merchandise_sales_brl` DESC LIMIT 10\n",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "displayName": "Count"
          }
        ]
      }
    }
